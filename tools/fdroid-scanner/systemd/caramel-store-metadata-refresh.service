[Unit]
Description=Refresh Caramel Store F-Droid metadata snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=caramel-scanner
Group=caramel-scanner
EnvironmentFile=-/etc/caramel-store/metadata-refresh.env
WorkingDirectory=/opt/caramel-vanilla-manifest
ExecStart=/opt/caramel-vanilla-manifest/tools/fdroid-scanner/systemd/run-metadata-refresh.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/caramel-store-scanner
